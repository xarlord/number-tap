<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Only back up SharedPreferences (high score, theme, sound prefs) -->
    <include domain="sharedpref" path="." />
    <!-- Exclude cache files (sound temp WAVs) -->
    <exclude domain="cache" path="." />
    <exclude domain="no_backup" path="." />
</full-backup-content>
